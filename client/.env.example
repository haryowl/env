# Vite / frontend env (optional)
# Copy to client/.env and rebuild (npm run build) for changes to apply

# Dev server: proxy target for /api requests (default: http://localhost:3000)
# VITE_PROXY_TARGET=http://localhost:3000

# Production build: API and WebSocket base URLs
#
# If users open the app as https://your-domain (same machine as the API), leave BOTH unset so the
# client uses /api and window.location.origin — avoids CSP blocking fetches to a raw IP while the
# page is served from a hostname.
#
# Only set these when the SPA is truly on a different origin than the API:
# VITE_API_BASE_URL=https://api.example.com
# VITE_WS_BASE_URL=wss://api.example.com
#
# Do NOT set VITE_API_BASE_URL to an IP if people use a domain in the browser (CSP connect-src).
# VITE_API_BASE_URL=http://81.17.100.7:3000
# VITE_WS_BASE_URL=http://81.17.100.7:3000
